# Copy this file to 'secrets.toml' and fill in your credentials
# 'secrets.toml' is ignored by git and never committed

[spotify]
# Client ID of the registered Spotify application
client_id = ""
# Client secret of the registered Spotify application
client_secret = ""
# Sign in with a Spotify account instead of authenticating as the application
# An app in Development Mode has to, it may only read the playlists of the
# account it is registered under, and only on behalf of that account
user_login = false
# Where Spotify sends the login back to, must be listed in the app settings
# Spotify rejects 'localhost', the loopback address has to be spelled out
redirect_uri = "http://127.0.0.1:8080/callback"

[deezer]
# Premium Deezer ARL (required by the 'deezer' backend)
# See https://rentry.org/firehawk52#deezer-arls
deezer_arl = ""

[qobuz]
# Qobuz user ID and auth token (required by the 'qobuz' backend)
user_id = ""
token = ""
# App ID and secret the auth token was issued for (required)
# A token is only valid under the app ID it was issued for, so the app
# credentials scraped from the Qobuz website will be rejected
app_id = ""
app_secret = ""
